# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local roster includes login cities/passwords
/data/roster.local.json
# Environment template is safe to version
!.env.example

/data/referee.local.json

# Local credentials, private keys and machine-specific configuration
*.local.json
*.key
*.p12
*.pfx
/.aws/
/.codex/
/.agents/

# Local caches, logs and database backups
__pycache__/
*.py[cod]
*.log
*.sql.gz
*.dump
/backups/
/tmp/
/test-results/
/playwright-report/
