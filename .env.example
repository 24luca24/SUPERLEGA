# Server-only PostgreSQL Supabase connection (Session pooler, TLS).
CONNECTION_STRING=postgresql://USER:[YOUR-PASSWORD]@HOST:5432/postgres?sslmode=require
DB_PASSWORD=

# Public Supabase settings (optional: app login uses server sessions).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Storage S3 endpoint and server credentials.
ENDPOINT_S3=https://PROJECT.supabase.co/storage/v1/s3
S3_REGION=
ACCESS_ID_KEY=
SECRET_ACCESS_KEY=
S3_BUCKET=superlega-media
FILE_SIZE=4MB

# For native AWS S3 instead: omit ENDPOINT_S3 and use these credentials/a workload role.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
